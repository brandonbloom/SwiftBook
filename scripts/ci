#!/usr/bin/env bash
# Everything that must pass before a change lands. Runs identically locally and in GitHub Actions.
set -euo pipefail
: "${SWIFTBOOK_HOME:?}"
cd "$SWIFTBOOK_HOME"
# Warnings fail CI: the package's targets read this (see Package.swift).
export SWIFTBOOK_STRICT=1

# Style: swift-format's defaults, indented 4 spaces (.swift-format). `swift format -i` fixes
# most findings.
git ls-files -z '*.swift' | xargs -0 swift format lint --strict --parallel
# Resolve only from Package.resolved, so a moved tag upstream can't change what builds.
swift build --build-tests --force-resolved-versions
swift test --skip-build --quiet
# The zoo's tests exercise SwiftBook as a consuming package would. Its manifest treats warnings as
# errors.
swift test --package-path Fixtures/PreviewZoo --force-resolved-versions --quiet
# Everything must also build for the simulator platforms, warning-free. Each entry is
# "<package dir>:<scheme>"; a package with several products gets a "-Package" scheme.
for entry in .:SwiftBook-Package Fixtures/PreviewZoo:PreviewZoo; do
  package="${entry%%:*}" scheme="${entry##*:}"
  for platform in iOS tvOS; do
    log="$(cd "$package" && xcodebuild -quiet -scheme "$scheme" \
      -destination "generic/platform=$platform Simulator" -derivedDataPath .build/xcode \
      SWIFT_TREAT_WARNINGS_AS_ERRORS=YES build 2>&1)" || {
      echo "$log" >&2
      exit 1
    }
    if grep 'warning:' <<<"$log"; then
      echo "ci: $package: $platform build warnings" >&2
      exit 1
    fi
  done
done
echo "ci: ok"
