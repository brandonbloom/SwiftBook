#!/usr/bin/env bash
# What GitHub Actions checks on its hosted runners: style, a warning-free build, the tests that need
# no window server, renderer, or simulator, and builds for the simulator platforms. scripts/ci-local
# runs this and everything else; see AGENTS.md.
set -euo pipefail
: "${SWIFTBOOK_HOME:?}"
cd "$SWIFTBOOK_HOME"
# Warnings fail CI: the package's targets read this (see Package.swift).
export SWIFTBOOK_STRICT=1

# Style: swift-format's defaults, indented 4 spaces (.swift-format). `swift format -i` fixes
# most findings.
git ls-files -z '*.swift' | xargs -0 swift format lint --strict --parallel
# Resolve only from Package.resolved, so a moved tag upstream can't change what builds.
swift build --build-tests --force-resolved-versions
swift test --skip-build --quiet --skip "$(cat scripts/ui-suites)"
# Everything must also build for the simulator platforms, warning-free. SWIFTBOOK_STRICT makes our
# targets' warnings errors; a global SWIFT_TREAT_WARNINGS_AS_ERRORS would clash with dependencies
# that suppress theirs. Each entry is "<package dir>:<scheme>"; a package with several products gets
# a "-Package" scheme.
for entry in .:SwiftBook-Package Fixtures/PreviewZoo:PreviewZoo; do
  package="${entry%%:*}" scheme="${entry##*:}"
  for platform in iOS tvOS; do
    log="$(cd "$package" && xcodebuild -quiet -scheme "$scheme" \
      -destination "generic/platform=$platform Simulator" -derivedDataPath .build/xcode \
      build 2>&1)" || {
      echo "$log" >&2
      exit 1
    }
    if grep 'warning:' <<<"$log"; then
      echo "ci: $package: $platform build warnings" >&2
      exit 1
    fi
  done
done
echo "ci: ok"
